{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MAPI",
  "version": "0.1.12",
  "identifier": "ca.mapi.finance",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MAPI",
        "width": 1440,
        "height": 940,
        "minWidth": 1050,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:18421 https:; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/mapi-backend/**/*"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
